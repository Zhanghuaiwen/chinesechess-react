{
  "name": "chinesechess-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chinese-chess online server: room battles with authoritative validation",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
